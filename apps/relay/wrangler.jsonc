{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gostop-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-23",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
